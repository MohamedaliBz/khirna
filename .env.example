# Copier ce fichier en .env.local et remplir avec les valeurs de votre projet Supabase
# (Supabase → Project Settings → API). Sans ces valeurs, l'app tourne en mode local.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon

# URL du backend de l assistant IA (assistant/khirna-ai-assistant). Sans backend, le widget affiche "hors ligne".
VITE_ASSISTANT_URL=http://127.0.0.1:8000
